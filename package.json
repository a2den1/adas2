{
  "name": "adas2",
  "version": "2.0.0",
  "description": "웹용 UI 툴킷 — 테마·팩토리·창 관리자·툴팁·단축키 (A web UI toolkit with themes, a factory API, windows, tooltips and shortcuts)",
  "keywords": [
    "ui",
    "toolkit",
    "components",
    "theme",
    "window-manager",
    "tooltip",
    "shortcut",
    "color-picker",
    "korean"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "a2den1",
  "homepage": "https://adas2-six.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2den1/adas2.git"
  },
  "bugs": {
    "url": "https://github.com/a2den1/adas2/issues"
  },
  "main": "dist/adas2.js",
  "module": "dist/adas2.esm.js",
  "types": "types/adas2.d.ts",
  "style": "dist/adas2.css",
  "unpkg": "dist/adas2.min.js",
  "jsdelivr": "dist/adas2.min.js",
  "exports": {
    ".": {
      "types": "./types/adas2.d.ts",
      "import": "./dist/adas2.esm.js",
      "default": "./dist/adas2.js"
    },
    "./css": "./dist/adas2.css",
    "./dist/*": "./dist/*"
  },
  "sideEffects": [
    "*.css",
    "./dist/adas2.js",
    "./dist/adas2.esm.js",
    "./dist/adas2.min.js",
    "./dist/adas2.esm.min.js"
  ],
  "files": [
    "dist",
    "types",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "python serve.py 5880"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
